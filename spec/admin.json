{
    "openapi": "3.0.0",
    "info": {
        "title": "Админка приложения",
        "version": "1.0.0"
    },
    "paths": {
        "/api/admin/login": {
            "post": {
                "tags": [
                    "Авторизация"
                ],
                "summary": "Авторизация Супер пользователя",
                "description": "Для авторизации нужен логин и пароль пользователя",
                "operationId": "authSuperLogin",
                "requestBody": {
                    "description": "Логин и пароль",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "login": {
                                        "type": "string",
                                        "example": "super@admin"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "passwordSuperAdmin"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "Токен авторизации"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверные авторизационные данные",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "error": {
                                            "properties": {
                                                "error_code": {
                                                    "type": "integer",
                                                    "example": "2"
                                                },
                                                "error_msg": {
                                                    "type": "string",
                                                    "example": "Неверные авторизационные данные."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/login-code": {
            "post": {
                "tags": [
                    "Авторизация"
                ],
                "summary": "Авторизация Супер пользователя с кодом",
                "description": "Авторизация Супер пользователя с кодом подтверждения",
                "operationId": "authSuperLoginCode",
                "requestBody": {
                    "description": "Код подтверждения",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "code": {
                                        "type": "integer",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "Токен авторизации"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверные авторизационные данные",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "error": {
                                            "properties": {
                                                "error_code": {
                                                    "type": "integer",
                                                    "example": "2"
                                                },
                                                "error_msg": {
                                                    "type": "string",
                                                    "example": "Неверные авторизационные данные."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/login/{user}": {
            "get": {
                "tags": [
                    "Авторизация"
                ],
                "summary": "Авторизация под аккаунтом пользователя",
                "description": "Авторизация под аккаунтом пользователя",
                "operationId": "authUser",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "description": "Идентификатор сотрудника",
                        "required": true,
                        "example": "1"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "Токен авторизации"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Неверные авторизационные данные",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "error": {
                                            "properties": {
                                                "error_code": {
                                                    "type": "integer",
                                                    "example": "2"
                                                },
                                                "error_msg": {
                                                    "type": "string",
                                                    "example": "Неверные авторизационные данные."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/admin/logs": {
            "get": {
                "tags": [
                    "Логи приложения"
                ],
                "summary": "Список файлов логов",
                "description": "Список файлов логов",
                "operationId": "logsList",
                "responses": {
                    "200": {
                        "description": "Ответ",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "example": [
                                                "название файла"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/admin/logs/download": {
            "get": {
                "tags": [
                    "Логи приложения"
                ],
                "summary": "Скачивание файла лога",
                "description": "Скачивание файла лога",
                "operationId": "logsDownload",
                "parameters": [
                    {
                        "name": "file",
                        "in": "query",
                        "description": "Название файла",
                        "required": true,
                        "example": "laravel.log"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Файл"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "tags": [
        {
            "name": "Авторизация",
            "description": "Авторизация"
        },
        {
            "name": "Логи приложения",
            "description": "Логи приложения"
        }
    ],
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Введите token в следующем формате: Bearer Ваш Api Token",
                "name": "Authorization",
                "in": "header"
            }
        }
    }
}