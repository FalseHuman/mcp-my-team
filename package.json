{
  "name": "mcp-my-team",
  "version": "1.0.3",
  "description": "MCP-сервер для API HR/таск-платформы «МояКоманда»",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-my-team": "dist/index.js"
  },
  "files": [
    "dist",
    "spec",
    "docs",
    "LICENSE",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "list-tools": "npm run build && node scripts/list-tools.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "myteam",
    "моякоманда",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FalseHuman/mcp-my-team.git"
  },
  "homepage": "https://github.com/FalseHuman/mcp-my-team#readme",
  "bugs": {
    "url": "https://github.com/FalseHuman/mcp-my-team/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^5.0.5",
    "dotenv": "^16.5.0",
    "form-data": "^4.0.2",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
